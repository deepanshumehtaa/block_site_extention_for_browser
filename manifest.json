{
  "manifest_version": 3,
  "name": "Site Blocker for Edge",
  "version": "1.0.0",
  "description": "Block any website by base URL or domain with a custom block landing page.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "webNavigation",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Site Blocker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked/blocked.html",
        "blocked/blocked.css",
        "blocked/blocked.js",
        "utils/url-helper.js",
        "qna/md5.js",
        "qna/math-generator.js",
        "qna/questions.js",
        "defaults/default-blocked-sites.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
